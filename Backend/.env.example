# Backend scripts (scripts/bootstrap-admin.mjs, scripts/seed.mjs). SERVER-SIDE ONLY.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# First admin (used by `npm run bootstrap-admin`)
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=ChangeThisNow-12345
ADMIN_NAME=System Administrator

# Dev seed users share this password (used by `npm run seed`)
SEED_PASSWORD=choose-a-strong-demo-password

# Only needed for `supabase db push` / type generation
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Direct Postgres connection (Project Settings -> Database). Used by `npm run migrate`.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
