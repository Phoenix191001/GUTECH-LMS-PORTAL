# Copy to .env.local and fill in. Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for admin user creation and the
# login/reset rate-limit gates (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Used in password-reset redirect links. Add it (and /auth/confirm) to the
# Supabase redirect allow list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
